<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-visible English word in the player-facing UI lives here, and nowhere else.

  Keys are <screen>_<thing>, lowercase, no abbreviations: `tracking_state_live`,
  `games_result_draw`. A counted quantity goes through <plurals> and NEVER through string
  concatenation in Kotlin — German pluralises differently, and a label assembled in code cannot
  say so. Format arguments are positional (%1$s, %2$d) because a translation reorders them.

  `values-de/` translates these and adds no keys of its own; a key it cannot find is a gap to be
  reported, not one to invent in English.

  What does NOT belong here: `ui/debug/` and the tuning knobs behind the developer door, whose
  vocabulary IS English (`census threshold`); anything written to disk or the wire (PGN tags,
  SAN, UCI, square names, log lines), which stays Locale.ROOT.

  This file held 171 entries on 2026-08-13, of which three were referenced by anything — the rest
  described UI deleted over specs/43-51. It is a live file again, not an archive.
-->
<resources>
    <string name="app_name">chesslab tracker</string>

    <!-- Foreground service -->
    <string name="notif_channel">Move tracking</string>
    <string name="notif_title">chesslab is tracking the board</string>

    <!-- Tracking: what the header is saying (TrackerLabel) -->
    <string name="tracking_state_live">Live</string>
    <string name="tracking_state_hand">Hand over board</string>
    <string name="tracking_state_no_detection">Not reading the board</string>
    <string name="tracking_state_lost">Board doesn\'t match</string>
    <string name="tracking_state_camera_off">Camera off</string>
    <string name="tracking_state_off">Not tracking</string>

    <!-- Tracking: the game line, opposite the state. `tracking_move_number` looks pointless in
         English and is not — German writes "14." with the period, and the "·" between the two
         halves is layout, not language. -->
    <string name="tracking_turn_white">White to move</string>
    <string name="tracking_turn_black">Black to move</string>
    <string name="tracking_move_number">%1$d</string>

    <!-- Tracking: the two camera controls in the app bar. The words are also their accessible
         names, so they stay the same whichever way the toggle stands. -->
    <string name="tracking_light">Camera light</string>
    <string name="tracking_camera_view">Camera view</string>

    <!-- Setting the board up: a framing aid, never a claim that the board was found. -->
    <string name="tracking_aim">Fit the whole board inside the frame</string>

    <!-- Tracking: taking a move back. One press unwinds the last COMMIT, which a CNN recovery can
         make several plies long — hence a plural rather than a fixed word. -->
    <plurals name="tracking_take_back">
        <item quantity="one">Take back move</item>
        <item quantity="other">Take back %1$d moves</item>
    </plurals>
    <string name="tracking_take_back_detail">One press takes back: %1$s</string>

    <!-- Ending a game where it is played. It always saves; deleting lives on the Games screen,
         where you can see what you are deleting. -->
    <string name="endgame_title">How did the game end?</string>
    <string name="endgame_new_title">Start a new game?</string>
    <string name="endgame_moves">%1$d moves recorded.</string>
    <string name="endgame_nothing">Nothing is recorded yet. This re-seeds the tracker from the starting position.</string>
    <string name="endgame_question">How did it end?</string>
    <string name="endgame_mate_white">Black is checkmated — White wins.</string>
    <string name="endgame_mate_black">White is checkmated — Black wins.</string>
    <string name="endgame_drawn">The position is a draw.</string>
    <string name="endgame_names_hint">Leave blank to skip.</string>
    <string name="endgame_save">Save &amp; new game</string>
    <string name="endgame_new">New game</string>

    <!-- The stored game's editor, which is where a stated result can be corrected. -->
    <string name="games_edit_title">Edit game details</string>
    <string name="games_white">White</string>
    <string name="games_black">Black</string>
    <string name="games_event">Event</string>
    <string name="games_result_edit">Result</string>
    <string name="games_save">Save</string>
    <string name="games_cancel">Cancel</string>

    <!-- How a game ended. One result, one word, in the library and in the review alike. -->
    <string name="games_result_white">White wins</string>
    <string name="games_result_black">Black wins</string>
    <string name="games_result_draw">Draw</string>
    <string name="games_result_unfinished">Unfinished</string>
</resources>
