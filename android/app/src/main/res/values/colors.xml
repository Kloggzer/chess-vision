<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window only. Mirrors `PaperPalette.background` in `ui/theme/Color.kt`; the
         night qualifier mirrors `InkPalette.background`. Without both, every cold start flashes
         the wrong scheme before Compose draws. -->
    <color name="chesslab_background">#FFEAE3D5</color>

    <!-- The mark's ink, per scheme, for the places that cannot tint at the use site: the splash
         icon and any `ImageView`. Compose tints `ic_logo` itself and ignores this. -->
    <color name="chesslab_logo">#FF2B2620</color>

    <!-- The adaptive icon's background layer. It does NOT follow the night setting — a launcher
         icon is one artwork, and the themed variant is the `<monochrome>` layer instead. -->
    <color name="ic_launcher_background">#FFF3EDE3</color>
</resources>
