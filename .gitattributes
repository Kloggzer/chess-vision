# Normalize line endings: LF in the repo for all text files.
# (Mixed CRLF/LF caused a 2700-line phantom diff in a test commit, 2026-07-09.)
* text=auto

*.py    text eol=lf
*.pyi   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.sh    text eol=lf

# Windows-native scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.onnx binary
*.pt binary
*.pth binary
*.npz binary
*.zip binary
*.jar binary
*.ttf binary
*.woff binary
*.woff2 binary
