{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capture-plan",
  "description": "Aufnahmeauftraege aus gemessenen Korpusluecken. Erzeugt von `chesslab capture plan`; die EINZIGE Autoritaet der Auftragsform. Python, TypeScript und Kotlin schreiben sie ab.",
  "type": "object",
  "required": ["generated_at", "dataset", "gaps_from", "shots"],
  "properties": {
    "generated_at": {"type": "string", "description": "ISO-8601, wann der Plan gerechnet wurde."},
    "dataset": {"type": "string"},
    "gaps_from": {"type": "string", "description": "Pfad der gelesenen coverage-gaps.json."},
    "shots": {"type": "array", "items": {"$ref": "#/$defs/shot"}}
  },
  "$defs": {
    "placement": {
      "type": "object",
      "required": ["square", "piece"],
      "properties": {"square": {"type": "string"}, "piece": {"type": "string"}}
    },
    "gap": {
      "type": "object",
      "required": ["piece", "square_color", "band", "have", "fix", "corpus_in_band"],
      "properties": {
        "piece": {"type": "string"},
        "square_color": {"enum": ["light", "dark"]},
        "band": {"type": "string"},
        "have": {"type": "integer"},
        "fix": {"enum": ["Stellung", "Licht"]},
        "corpus_in_band": {"type": "integer"}
      }
    },
    "shot": {
      "type": "object",
      "required": ["id", "fix", "reason", "place", "light", "reference_square", "height",
                   "orientations", "closes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$",
               "description": "{piece}-{square_color}-{band}. Das Band MUSS hinein: 58 Luecken verteilen sich auf 24 Paare aus Figur und Feldfarbe, 22 davon kollidieren ueber die Baender."},
        "fix": {"enum": ["Stellung", "Licht"]},
        "reason": {"type": "string"},
        "place": {"type": "array", "items": {"$ref": "#/$defs/placement"},
                  "description": "Leer bei fix=Licht. Das Feld ist das der Bandmitte naechste seiner Farbe — 'hellstes bzw. dunkelstes' waere fuer das Band 'mittel' nicht entscheidbar."},
        "light": {"type": ["string", "null"],
                  "description": "Bei fix=Licht das Zielband, sonst null."},
        "reference_square": {"type": "string",
                             "description": "Feld, an dem der Nutzer das Licht beurteilt."},
        "height": {"enum": ["tief", "normal", "hoch"]},
        "orientations": {"type": "integer",
                         "description": "Drehschritte zu je 360/orientations Grad."},
        "closes": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
      }
    }
  }
}
